# 凭据
.env
# init-env --force、setup-mcp、以及各 agent 配置的备份都可能含凭据或本机路径
*.bak-*

# 本机专属的 MCP 注册（含绝对路径）。
# `.mcp.json.example` 是模板、会入库；实际文件由
# `python scripts/setup_mcp.py` 生成。
.mcp.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# Playwright
playwright-report/
test-results/
# 浏览器把日志写进 cwd 时产生的文件（启动 chromium 实测会生成）
debug.log

# 临时截图（脚本运行产物）
/tmp/elang_screenshots/

# 其他
# 归档的旧实现与旧文档。保留在本地供查阅，不入库：
# 它们描述的是已废弃的协议与安装方式，放在仓库里只会让读者误判现状。
/archive/

/temp/  

# 维护者本地的开发日志：记实测细节与踩过的坑。
# 不入库的原因：它按时间追加、越写越长，且夹杂当时有效后来被推翻的结论，
# 放进公开仓库容易让读者把过时判断当成现状。新克隆里没有它是正常的。
CHANGELOG.md

# 项目级 skill 安装目标（由 install-skill --scope project 写入）。
# 想随项目提交 skill（让协作者自动获得）时，删掉这几行即可。
/.dsh/skills/
/.agents/skills/
/.claude/skills/

# Playwright 浏览器缓存（工作区内，避免污染系统 ms-playwright）
.playwright-browsers/
