# 凭据
.env

# 本机专属的 MCP 注册（含绝对路径）。
# `.mcp.json.example` 是模板、会入库；实际文件由
# `python scripts/setup_mcp.py` 生成。
.mcp.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# Playwright
playwright-report/
test-results/

# 临时截图（脚本运行产物）
/tmp/elang_screenshots/

# 其他
/temp/  

# 项目级 skill 安装目标（由 install-skill --scope project 写入）。
# 想随项目提交 skill（让协作者自动获得）时，删掉这几行即可。
/.dsh/skills/
/.agents/skills/
/.claude/skills/

# Playwright 浏览器缓存（工作区内，避免污染系统 ms-playwright）
.playwright-browsers/
